expression 'Order Info' =
		let
		  Source = Table.NestedJoin(order_items, {"order_id"}, orders, {"order_id"}, "orders", JoinKind.LeftOuter),
		  #"Expanded orders" = Table.ExpandTableColumn(Source, "orders", {"customer_id", "order_date", "status", "shipping_fee"}, {"customer_id", "order_date", "status", "shipping_fee"}),
		  #"Added custom" = Table.AddColumn(#"Expanded orders", "Total Price", each ([quantity] * [unit_price]) - [discount_amount]),
		  #"Grouped rows" = Table.Group(#"Added custom", {"order_id"}, {{"Sum Total Price", each List.Sum([Total Price]), type any}, {"Shipping Fee", each List.Min([shipping_fee]), type nullable number}, {"Order Date", each List.Min([order_date]), type nullable datetime}}),
		  #"Changed column type" = Table.TransformColumnTypes(#"Grouped rows", {{"Order Date", type date}}),
		  #"Added custom 1" = Table.AddColumn(#"Changed column type", "Revenue", each [Sum Total Price] - [Shipping Fee]),
		  #"Removed columns" = Table.RemoveColumns(#"Added custom 1", {"Sum Total Price", "Shipping Fee"}),
		  #"Filtered rows" = Table.SelectRows(#"Removed columns", each ([Order Date] <> null) and ([Revenue] <> null)),
		  #"Changed column type 1" = Table.TransformColumnTypes(#"Filtered rows", {{"Revenue", Currency.Type}})
		in
		  #"Changed column type 1"
	lineageTag: ebfeb769-cc97-4d11-be16-c2b3c3e75c75

	annotation PBI_ResultType = Table

